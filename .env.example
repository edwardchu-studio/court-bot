# 复制为 .env 并填值 (chmod 600 .env)

# 通知方式: desktop | telegram | both
# - desktop (默认): macOS 通知中心 + stdout, 零配置
# - telegram: 推 TG bot (需自建 bot, 见下面 TG_* 字段)
# - both: 两者都发
NOTIFY_PROVIDER=desktop

# 仅 NOTIFY_PROVIDER=telegram 或 both 时才需要填:
# 1. @BotFather 创建 bot 拿 token
# 2. 给 bot 发一条消息, 然后 curl https://api.telegram.org/bot<TOKEN>/getUpdates 拿 chat_id
TG_BOT_TOKEN=
TG_CHAT_ID=
